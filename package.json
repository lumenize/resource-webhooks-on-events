{
  "name": "resource-webhooks-on-events",
  "version": "0.0.0",
  "private": true,
  "description": "A prototype MCP extension: keep copies of resources current by webhook, with SEP-3415 Events and catch-ups",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run check:schema && vitest run",
    "type-check": "tsc --noEmit",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars false",
    "generate:schema": "node scripts/generate-schemas.mjs",
    "check:schema": "node scripts/generate-schemas.mjs --check",
    "conformance": "node scripts/conformance.mjs",
    "deployed": "node scripts/deployed.mjs",
    "conformance:client": "npx --yes @modelcontextprotocol/conformance@0.2.0-alpha.12 client --command \"node scripts/conformance-client.mjs\" --requirements 2026-07-28 --expected-failures ./conformance-baseline.yml"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@types/node": "^24.19.2",
    "standardwebhooks": "1.1.1",
    "typescript": "5.9.3",
    "typescript-json-schema": "0.65.1",
    "vitest": "4.1.10",
    "wrangler": "4.147.0"
  }
}
