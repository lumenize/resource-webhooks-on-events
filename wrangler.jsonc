{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resource-webhooks-on-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // A's webhook POST to B, on this Worker's own host, goes out through Cloudflare's front
  // door like a POST to any other receiver.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      { "name": "SERVER", "class_name": "Server" },
      { "name": "GATEWAY", "class_name": "Gateway" }
    ]
  },
  "exports": {
    "Server": { "type": "durable-object", "storage": "sqlite" },
    "Gateway": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    // The Worker's own origin, and the only one whose requests it accepts. A constant per
    // environment, never computed from a request.
    "ORIGIN": "https://resource-webhooks-on-events.transformation.workers.dev",
    // The one instance under /server the edge routes to, A, and under /gateway, B.
    "SERVER_INSTANCE": "A",
    "GATEWAY_INSTANCE": "B",
    // How many accounts A's authorization server may create between Wipes, one per new browser.
    "ACCOUNT_CAP": "1000",
    // How long A keeps a superseded revision's contents, and a deletion, before a later write
    // prunes them (R21).
    "CUTOFF_WINDOW_MS": "86400000",
    // The delays between A's delivery attempts, held to SEP-3415's bounds of 3 to 5 attempts
    // over at most 15 minutes.
    "RETRY_SCHEDULE_MS": "30000,120000,300000",
    // How long one delivery attempt may take before it counts as a timeout.
    "ATTEMPT_TIMEOUT_MS": "5000",
    // The longest subscription A grants, and the one it grants when asked for none.
    "SUBSCRIPTION_TTL_MS": "3600000",
    // How many subscriptions one principal may hold.
    "SUBSCRIPTION_CAP": "100",
    // How many verification POSTs one host may receive in a burst, refilled one a minute.
    "VERIFICATION_BURST": "10",
    // How often a client pings B on its socket. B treats a socket two intervals quiet as closed.
    "HEARTBEAT_MS": "30000",
    // How many resources one page of a collection read, or one catch-up, carries at most. A
    // catch-up runs on past this and the next two to finish a moment.
    "PAGE_SIZE": "100",
    // How many rows one page of a collection read, or one catch-up, scans at most, its
    // collection's or another's on the same timeline: each resource's newest row for a read, and
    // every row for a catch-up.
    "SCAN_LIMIT": "1000",
    // How many bytes of contents one page of a collection read, or one catch-up, carries before
    // it stops.
    "PAGE_BYTES": "262144",
    // How many of a collection's changes one moment may hold, past which a catch-up answers
    // momentTooLarge and the client reads the collection again.
    "MOMENT_CHANGE_CAP": "1000",
    // The largest body an event may have, in bytes, as SEP-3415 asks, past which it leaves its
    // change-set entries out.
    "EVENT_BODY_LIMIT": "262144"
  },
  // The version each object runs, which it tells the page, since a deploy reaches each object late.
  "version_metadata": { "binding": "VERSION" },
  "observability": { "enabled": true }
}
